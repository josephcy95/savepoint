{
  "name": "savepoint",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A personal game journal built for AI agents: MCP + REST API + web UI, one container, one SQLite file.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --run dev:server & node --run dev:web; wait",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "@modelcontextprotocol/sdk": "1.31.0",
    "hono": "4.12.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wouter": "3.11.0"
  }
}
